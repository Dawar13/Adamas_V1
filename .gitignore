# Build output — firmware binaries are produced, never committed.
build/
*.elf
*.bin
*.hex
*.map

# Node
node_modules/
dist/
.astro/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Secrets
.env
.env.*
!.env.example

# Emulator / toolchain caches
renode-cache/
.renode/

# Per-run scratch output: generated .resc, event logs, emulator logs, consoles,
# results.json and traces. Reproducible from the scenario plus the pinned
# toolchain, so it is not history. Committed run history arrives in Phase 2 under
# app/project/runs/.
harness/out/
*.robot.generated

# Expanded tests. Derived from patterns/ plus scenarios/ by harness/expand.py and
# regenerated on every run. Committing them would create a second source of truth
# for what the suite asserts — and the moment a committed test could disagree with
# the scenario it came from, the generator itself stops being verifiable.
.generated/

# Expanded tests are derived from patterns/ + scenarios/ and regenerated every
# run. Committing them would create a second source of truth and make the sweep
# generator unverifiable.
.generated/
suite-run.log
# Evidence and results belong to the project directory now (PROJECT-V2 §8.1).
projects/*/spike-snapshot/
projects/*/verify-refusals/
# Every spike's evidence, whatever it is called next time: these directories
# hold multi-megabyte snapshots and emulator logs, and one of them reached a
# commit because the ignore rule named the two spikes that existed that day.
projects/*/spike-*/
projects/*/runs/

# Build output — firmware binaries are produced, never committed.
build/
*.elf
*.bin
*.hex
*.map

# Node
node_modules/
dist/
.astro/

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Secrets
.env
.env.*
!.env.example

# Emulator / toolchain caches
renode-cache/
.renode/

# Per-run scratch output: generated .resc, event logs, emulator logs, consoles,
# results.json and traces. Reproducible from the scenario plus the pinned
# toolchain, so it is not history. Committed run history arrives in Phase 2 under
# app/project/runs/.
harness/out/
*.robot.generated

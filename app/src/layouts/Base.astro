---
import "../app/styles/tokens.css";
import "../app/styles/results.css";
const { title } = Astro.props;
// The surface is chosen by route, not by preference: bench is where you author,
// instrument is where you observe.
const path = Astro.url.pathname;
const bench = path === "/" || path.startsWith("/system") || path.startsWith("/firmware")
  || path.startsWith("/tests") || path.startsWith("/requirements");
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
  </head>
  <body class={bench ? "bench-surface" : ""}>
    <header class="topbar">
      <a class="brand" href="/">Bench</a>
      <nav class="topnav">
        <a href="/system">System</a>
        <a href="/firmware">Firmware</a>
        <a href="/tests">Tests</a>
        <span class="topnav-divider">·</span>
        <a href="/render">Render</a>
        <a href="/runs">Runs</a>
      </nav>
      <span class="brand-note">software-in-the-loop firmware validation</span>
    </header>
    <main class="page">
      <slot />
    </main>
  </body>
</html>

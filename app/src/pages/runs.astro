---
import Base from "../layouts/Base.astro";
import { listRuns } from "../../server/store/loaders/runs.mjs";

/*
 * Run history -- Phase 3 section 6.
 *
 * TWO OPERATIONS, NEVER CONFLATED.
 *
 *   Open    loads what was stored. Instant. Nothing executes.
 *   Replay  re-runs it from scratch. Full duration. Byte-identical results.
 *
 * Replay is the demo weapon -- "watch, I'll run it from scratch", same
 * microseconds, impossible on hardware. Which is exactly why a button labelled
 * replay must never quietly show a stored result instead. If those two were
 * ever confused, the strongest claim this product makes would be the one it
 * could not back up.
 *
 * Running from the interface is section 3.7 and is not built. So replay here
 * hands over the command that reproduces the run, rather than a button that
 * appears to execute and does not.
 *
 * A run missing provenance does not appear as a run. The engine enforces this
 * at the schema and the loader enforces it again on read; this screen must not
 * work around either.
 */
/*
 * A directory-level failure -- the runs root unreadable, a permission error --
 * used to escape as a 500 with a stack trace on the studio's home page. An
 * error page that says nothing is the one place a tool cannot afford to be
 * vague, because it is where someone lands when something is already wrong.
 */
let runs = [];
let listingFailed = null;
try {
  runs = await listRuns();
} catch (err) {
  listingFailed = err.message;
}

const readable = runs.filter((run) => run.readable);
const refused = runs.filter((run) => !run.readable);

function tally(run) {
  const other = Object.entries(run.counts || {})
    .filter(([outcome]) => outcome !== "pass")
    .sort();
  return other;
}

/*
 * THREE STATES, NOT TWO.
 *
 * This was `run.passed === run.tests`. The loader supplies null for both when
 * summary.json does not record them, so `null === null` painted the reserved
 * green and the word "pass" on a run whose verdict was never measured -- and the
 * inverse painted an unmeasured "fail" in red. A two-branch comparison over
 * three states manufactures a verdict out of two absences, which is the single
 * worst thing a screen in this product can do.
 *
 * harness/store.py refuses to WRITE a summary missing these counts. Nothing
 * checked them on read, and the loader's own header explains why that matters:
 * a run directory can be copied in, restored from a backup, or half-written by
 * a job that was killed.
 */
function verdictOf(run) {
  if (typeof run.passed !== "number" || typeof run.tests !== "number") {
    return { state: "unmeasured", label: "no result recorded" };
  }
  if (run.tests === 0) {
    return { state: "unmeasured", label: "no tests" };
  }
  return run.passed === run.tests
    ? { state: "pass", label: "pass" }
    : { state: "fail", label: "fail" };
}
---

<Base title="Runs — Bench">
  <h1 class="page-head">Stored runs</h1>

  {listingFailed && (
    <section class="empty is-refused">
      <h3>The stored runs could not be listed.</h3>
      <p class="mono">{listingFailed}</p>
      <p>
        This is a problem reading <code>project/runs/</code>, not a statement
        that no runs exist. Nothing has been hidden.
      </p>
    </section>
  )}

  {!listingFailed && runs.length === 0 && (
    <section class="empty">
      <h3>No runs are stored yet.</h3>
      <p>
        A run appears here once the suite has been executed and merged. Nothing
        on this screen is sample data — an empty history means nothing has run.
      </p>
      <p class="empty-how">
        <code>bash scripts/run-suite-sharded.sh</code>
      </p>
    </section>
  )}

  <ul class="runlist">
    {readable.map((run) => (
      <li class="run">
        <div class="run-head">
          <a class="run-id mono" href={`/runs/${run.id}`}>{run.id}</a>
          <span class={`outcome is-${verdictOf(run).state}`}>
            {verdictOf(run).label}
          </span>
          <span class="run-tally mono">
            {typeof run.passed === "number" && typeof run.tests === "number"
              ? `${run.passed} / ${run.tests}`
              : "—"}
          </span>
          {tally(run).map(([outcome, n]) => (
            <span class="run-other">
              <span class="mono">{n}</span> {outcome}
            </span>
          ))}
          {run.complete === false && (
            <span class="chip chip-warn">PARTIAL — not a suite result</span>
          )}
        </div>

        <div class="run-meta mono">
          {run.shards ? <span>{run.shards} shards</span> : null}
          {Object.entries(run.firmware).map(([node, digest]) => (
            <span>{node} {digest.slice(0, 8)}</span>
          ))}
        </div>

        <div class="run-actions">
          <a class="btn" href={`/runs/${run.id}`}>open</a>
          <details class="replay-detail">
            <summary class="btn">replay</summary>
            <div class="replay-body">
              <p>
                Replay <strong>re-executes</strong> the run and must produce
                byte-identical results. It takes as long as the run did — it is
                not a faster way to see what is already stored.
              </p>
              <p>
                Triggering it from here is section 3.7 and is not built, so this
                is the command rather than a button that only looks live:
              </p>
              <pre class="replay">{(run.replay || "").trim() || "This run stored no reproduction note."}</pre>
            </div>
          </details>
          <a class="btn" href={`/api/runs/${run.id}`} download={`${run.id}.json`}>
            download record
          </a>
        </div>
      </li>
    ))}
  </ul>

  {refused.length > 0 && (
    <section class="refused-block">
      <h2 class="section-head">Not shown as runs</h2>
      <p class="muted">
        These directories are present and are not results. A result that cannot
        be traced to the binaries and tools that produced it still looks like
        evidence, which is worse than an absent one. They are listed rather than
        hidden, because a run that silently vanishes is indistinguishable from
        one that was never made.
      </p>
      <ul class="runlist">
        {refused.map((run) => (
          <li class="run is-refused">
            <span class="run-id mono">{run.id}</span>
            <span class="run-reason">{run.reason}</span>
          </li>
        ))}
      </ul>
    </section>
  )}
</Base>

---
import Base from "../layouts/Base.astro";
import { loadDesign, DesignUnreadable } from "../../server/store/loaders/design.mjs";

/*
 * The design canvas -- Phase 3 section 7, read-only.
 *
 * Draws network.yml. Every visual element maps to a line in that file.
 *
 * CONNECTIONS ARE BUS-LEVEL, NOT PIN-LEVEL. Renode models peripherals, not
 * physical packages -- it has no concept of pin 84. A pin-to-pin wire would map
 * to nothing executable and would be a placeholder pretending to be a
 * specification, which is the one thing this product may not ship.
 *
 * Filled dot = real firmware executing. Hollow = a frame player. Star = the
 * device under test.
 *
 * Rendered entirely on the server: a read-only drawing needs no JavaScript, and
 * shipping a hydration bundle to draw six static boxes would be paying a cost
 * for nothing.
 */

let design = null;
let refused = null;
try {
  design = await loadDesign();
} catch (err) {
  if (err instanceof DesignUnreadable) refused = err.message;
  else throw err;
}
---

<Base title="Design — Bench">
  <h1 class="page-head">System</h1>

  {refused && (
    <section class="empty is-refused">
      <h3>The topology could not be read.</h3>
      <p>{refused}</p>
      <p class="empty-how">
        The canvas draws <code>network.yml</code> through the engine's own
        loader, so what you see here is exactly what the compiler would run. It
        will not draw a topology the compiler would reject.
      </p>
    </section>
  )}

  {design && (
    <>
      {design.buses.map((bus) => (
        <section class="bus-group">
          <div class="canvas">
            {design.nodes
              .filter((node) => node.buses.includes(bus.id))
              .map((node) => (
                <a class={`node ${node.dut ? "is-dut" : ""}`} href={`/design/${node.id}`}>
                  <div class="node-head">
                    <span class={`node-dot ${node.is_real ? "is-real" : "is-scripted"}`}
                          title={node.is_real
                            ? "real firmware, executing instruction by instruction"
                            : "a frame player: it emits frames on a schedule and runs no code"}
                    ></span>
                    <span class="node-id mono">{node.id}</span>
                    {node.dut && <span class="node-star" title="device under test">★</span>}
                  </div>

                  <div class="node-kind">
                    {node.is_real ? "REAL" : "SCRIPTED"}
                    {node.board_detail?.tier && (
                      <span class={`chip chip-tier is-${node.board_detail.tier}`}>
                        {node.board_detail.tier}
                      </span>
                    )}
                  </div>

                  {node.board_missing && (
                    <p class="node-missing">
                      board <span class="mono">{node.board}</span> is not in the
                      board table
                    </p>
                  )}

                  <ul class="node-ports">
                    {node.ports.map((port) => (
                      <li class="mono">{port.name}</li>
                    ))}
                    {node.is_scripted && (
                      <li class="node-emits mono">
                        emits {node.emits.map((id) => `0x${id.toString(16).toUpperCase()}`).join(" ")}
                        {node.period_ms ? ` every ${node.period_ms} ms` : ""}
                      </li>
                    )}
                  </ul>
                </a>
              ))}
          </div>

          <div class="bus-line" role="img" aria-label={`${bus.id} bus`}>
            <span class="bus-label mono">
              {bus.id} · {bus.type.toUpperCase()} · {(bus.bitrate / 1000).toFixed(0)} kbit/s
            </span>
          </div>
        </section>
      ))}

      <section class="legend">
        <span><span class="node-dot is-real"></span> real firmware, executing</span>
        <span><span class="node-dot is-scripted"></span> frame player, runs no code</span>
        <span><span class="node-star">★</span> device under test</span>
        <span class="legend-note">
          Connections are bus-level. The emulator models peripherals, not
          physical packages — there is no pin 84 to draw a wire to.
        </span>
      </section>

      <p class="muted source-note">
        Drawn from <code>{design.source || "network.yml"}</code> through the
        engine's own loader, so this is the system the compiler would run. Editing
        the canvas is section 3.8 and is not built; this screen is read-only.
      </p>
    </>
  )}
</Base>

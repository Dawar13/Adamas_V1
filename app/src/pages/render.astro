---
import Base from "../layouts/Base.astro";
import { renderChecks, RenderUnreadable } from "../../server/store/loaders/render.mjs";
import BringUp from "../app/views/BringUp.jsx";
import RunTests from "../app/views/RunTests.jsx";
import { readFile } from "node:fs/promises";
import path from "node:path";
import { REPO_ROOT } from "../../server/store/loaders/runs.mjs";
import { DesignUnreadable } from "../../server/store/loaders/design.mjs";

/*
 * Render -- Phase 3 section 10, the static half.
 *
 * Six checks over the project's own files. Green here means the system is
 * DESCRIBED consistently; it does not mean it starts, and the page says so
 * rather than letting a column of ticks imply it.
 *
 * The live boot check -- actually launching the emulator for two seconds -- is
 * the other half of section 10 and is not wired to this screen yet. It is
 * marked as such rather than mocked, because a tick claiming a boot nobody
 * performed is exactly the failure this product exists to refuse.
 */
const topology = Astro.url.searchParams.get("file") || undefined;
const boards = Astro.url.searchParams.get("boards") || undefined;
const contract = Astro.url.searchParams.get("contract") || undefined;

// The test plan, read from the generator's own manifest so the groups offered
// here and the tests that would actually run cannot disagree.
let groups = [];
try {
  const manifest = JSON.parse(await readFile(
    path.join(REPO_ROOT, Astro.url.searchParams.get("tests") || ".generated/tests", "manifest.json"),
    "utf8"));
  const byScenario = new Map();
  for (const test of manifest.tests || []) {
    const key = test.scenario ?? "(unnamed)";
    if (!byScenario.has(key)) byScenario.set(key, { scenario: key, tests: [] });
    byScenario.get(key).tests.push(test.id);
  }
  groups = [...byScenario.values()].sort((a, b) => a.scenario.localeCompare(b.scenario));
} catch {
  groups = [];   // no expanded suite: the run panel says so rather than offering one
}

let result = null;
let refused = null;
try {
  result = await renderChecks({ topology, boards, contract });
} catch (err) {
  if (err instanceof RenderUnreadable || err instanceof DesignUnreadable) refused = err.message;
  else throw err;
}
---
<Base title="Render — Bench">
  <h1 class="page-head">Render</h1>
  <p class="stage-lead">
    Two stages. The first reads your project's files. The second actually starts
    the emulator.
  </p>

  {refused && (
    <section class="empty is-refused">
      <h3>The project could not be read, so nothing could be checked.</h3>
      <p>{refused}</p>
    </section>
  )}

  {result && (
    <>
      <ul class="checks">
        {result.checks.map((check) => (
          <li class={`check is-${check.state}`}>
            <span class="check-mark" aria-hidden="true">
              {check.state === "ok" ? "✓" : check.state === "refused" ? "✗" : "✗"}
            </span>
            <span class="check-label">{check.label}</span>
            {check.detail && <span class="check-detail mono">{check.detail}</span>}
          </li>
        ))}
      </ul>

      <p class={`render-verdict is-${result.verdict}`}>
        {result.verdict === "ok" && (
          <>Described consistently — <span class="mono">{result.nodes}</span> nodes.</>
        )}
        {result.verdict === "refused" && (
          <>This system contains something Bench will not execute. See above.</>
        )}
        {result.verdict === "fault" && (
          <>This system would not run as described. See above.</>
        )}
      </p>

      {/*
        The honesty stays; its volume drops. It used to be a section heading set
        at the same weight as the passing checks, followed by two paragraphs of
        caveat -- so the loudest thing on the screen was a disclaimer, and the
        screen's message was "we are not sure" when the fact was "six checks
        passed and the other two happen in stage two". Quiet and always
        reachable, one click away.
      */}
      <details class="limits-note">
        <summary>what this stage doesn't check</summary>
        <p>{result.note}</p>
        <p>
          Starting the emulator and booting each binary is stage two below, and
          it runs for real. A verdict about the firmware comes only from a test
          run.
        </p>
      </details>

      <BringUp query={{ file: topology, boards: boards, contract: contract }} client:load />

      <RunTests
        query={{ file: topology, boards: boards, contract: contract }}
        groups={groups}
        client:load
      />
    </>
  )}
</Base>

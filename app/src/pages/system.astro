---
import Base from "../layouts/Base.astro";
import { loadDesign, DesignUnreadable } from "../../server/store/loaders/design.mjs";
import SystemCanvas from "../app/views/SystemCanvas.jsx";

/*
 * The system — the landing page, and a real bus topology.
 *
 * The previous version was six cards in a row with a horizontal rule under
 * them. The one thing an engineer looks for — which controller sits on which
 * bus — was the one thing not drawn. A CAN topology with no visible bus line is
 * a credibility leak: it says the tool has not understood the system it claims
 * to test.
 *
 * NOTHING HERE IS A LITERAL. Every node, bus, speed, board and peripheral is
 * read from the topology through the engine's own loader, at request time.
 * Layout is computed from that file and is deterministic — no physics, no force
 * simulation — so the same topology always draws the same way.
 */
const topology = Astro.url.searchParams.get("file") || undefined;
const boardsFile = Astro.url.searchParams.get("boards") || undefined;

let design = null;
let refused = null;
try {
  design = await loadDesign(topology, boardsFile);
} catch (err) {
  if (err instanceof DesignUnreadable) refused = err.message;
  else throw err;
}

const NODE_W = 208;
const NODE_H = 76;
const GAP_X = 40;
const RAIL_DROP = 56;
const BUS_BLOCK = 250;
const PAD = 48;

let width = 900;
let height = 320;
const lanes = [];

if (design) {
  const placed = new Set();
  design.buses.forEach((bus, index) => {
    const members = design.nodes.filter(
      (node) => node.buses.includes(bus.id) && !placed.has(node.id)
    );
    members.forEach((node) => placed.add(node.id));
    const top = PAD + index * BUS_BLOCK;

    lanes.push({
      bus: { id: bus.id },
      // Built here rather than in the component: every part of it comes from
      // the topology, and a bus with no declared rate says so instead of
      // showing a zero nobody wrote.
      label:
        bus.id +
        (bus.type ? ` · ${String(bus.type).toUpperCase()}` : "") +
        (typeof bus.bitrate === "number" && bus.bitrate > 0
          ? ` · ${(bus.bitrate / 1000).toFixed(0)} kbit/s`
          : " · rate not declared"),
      railY: top + NODE_H + RAIL_DROP,
      nodes: members.map((node, i) => ({
        node: {
          id: node.id,
          board: node.board,
          dut: node.dut,
          is_real: node.is_real,
          is_scripted: node.is_scripted,
          emits: node.emits,
          ports: node.ports,
          tier: node.board_detail?.tier ?? null,
        },
        x: PAD + i * (NODE_W + GAP_X),
        y: top,
      })),
    });
    width = Math.max(width, PAD * 2 + members.length * NODE_W + Math.max(0, members.length - 1) * GAP_X);
    height = Math.max(height, top + NODE_H + RAIL_DROP + PAD + 60);
  });
}
---

<Base title="System — Bench">
  {refused && (
    <section class="empty is-refused">
      <h3>The system could not be read.</h3>
      <p>{refused}</p>
    </section>
  )}

  {design && (
    <SystemCanvas
      lanes={lanes}
      width={width}
      height={height}
      search={Astro.url.search}
      client:load
    />
  )}
</Base>

  "scenario": {
    "id": "boot-sequence",
    "title": "Startup reaches every stage in order and leaves the contactor open",
    "description": "Watch the pack come up: banner, CAN controller ready, controller started, state machine out of INIT. Require that it puts nothing on its telemetry identifier before that, that the contactor is open once the loop is running, that the other two nodes reach their entry points, and that no fault is raised anywhere in startup \u2014 including across the window where an unguarded heartbeat timeout would fire.\n",
    "path": ".generated/tests/boot-sequence.yml",
    "sha256": "90e192829ef001a951272ff1c0bfb78d8ddd9facc1756515cad9f378e0cd15a3",
    "steps": [
      {
        "step": 1,
        "verb": "wait_uart",
        "params": {
          "node": "bms",
          "text": "BMS ready",
          "timeout_ms": 50,
          "label": "the pack reaches its application entry point"
        }
      },
      {
        "step": 2,
        "verb": "expect_no_can",
        "params": {
          "id": 1536,
          "for_ms": 40,
          "label": "the pack has not started transmitting before it is up"
        }
      },
      {
        "step": 3,
        "verb": "wait_uart",
        "params": {
          "node": "bms",
          "text": "bms can ready init_res=0",
          "timeout_ms": 50,
          "label": "its CAN controller initialised"
        }
      },
      {
        "step": 4,
        "verb": "wait_uart",
        "params": {
          "node": "bms",
          "text": "bms can_start rc=0",
          "timeout_ms": 50,
          "label": "its CAN controller started"
        }
      },
      {
        "step": 5,
        "verb": "wait_uart",
        "params": {
          "node": "bms",
          "text": "bms state INIT -> STANDBY",
          "timeout_ms": 50,
          "label": "the control loop is running: INIT -> STANDBY"
        }
      },
      {
        "step": 6,
        "verb": "expect_can",
        "params": {
          "id": 1538,
          "signals": {
            "contactor_state": "OPEN"
          },
          "within_ms": 150,
          "label": "the contactor is open at startup"
        }
      },
      {
        "step": 7,
        "verb": "expect_can",
        "params": {
          "id": 1536,
          "within_ms": 150,
          "label": "the pack publishes telemetry once it is up"
        }
      },
      {
        "step": 8,
        "verb": "wait_uart",
        "params": {
          "node": "vcu",
          "text": "VCU ready",
          "timeout_ms": 50,
          "label": "the vehicle controller reaches its entry point"
        }
      },
      {
        "step": 9,
        "verb": "wait_uart",
        "params": {
          "node": "charger",
          "text": "CHG ready",
          "timeout_ms": 50,
          "label": "the charger reaches its entry point"
        }
      },
      {
        "step": 10,
        "verb": "expect_no_can",
        "params": {
          "id": 1540,
          "for_ms": 300,
          "label": "no fault is raised anywhere in startup"
        }
      }
    ]
